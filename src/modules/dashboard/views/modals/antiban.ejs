<div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50" onclick="if(event.target === this) document.getElementById('modal-container').innerHTML = ''">
  <div class="bg-white rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5">
    <div class="flex items-center justify-between border-b pb-3">
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <h2 class="text-lg font-semibold text-gray-900">Anti-Ban Protection Details</h2>
      </div>
      <button onclick="document.getElementById('modal-container').innerHTML = ''" class="text-gray-400 hover:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Tenant Name -->
    <div class="flex justify-between items-center bg-gray-50 p-3 rounded-lg border border-gray-200">
      <div>
        <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tenant Name</span>
        <div class="text-sm font-semibold text-gray-800"><%= tenantName %></div>
      </div>
      <div>
        <% 
          let badgeClass = 'bg-green-100 text-green-800 border-green-200';
          if (riskLevel === 'medium') badgeClass = 'bg-yellow-100 text-yellow-800 border-yellow-200';
          if (riskLevel === 'high') badgeClass = 'bg-red-100 text-red-800 border-red-200';
          if (riskLevel === 'unknown') badgeClass = 'bg-gray-100 text-gray-800 border-gray-200';
        %>
        <span class="px-3 py-1 text-xs font-semibold rounded-full border <%= badgeClass %> uppercase">
          Risk: <%= riskLevel %>
        </span>
      </div>
    </div>

    <% if (enabled) { %>
    <!-- Health Score & Warmup Overview -->
    <div class="grid grid-cols-2 gap-4">
      <div class="p-3 bg-blue-50 border border-blue-100 rounded-lg text-center">
        <span class="text-xs text-blue-600 font-medium">Health Score</span>
        <div class="text-2xl font-bold text-blue-900 mt-1"><%= score %>%</div>
      </div>
      <div class="p-3 bg-purple-50 border border-purple-100 rounded-lg text-center">
        <span class="text-xs text-purple-600 font-medium">Warm-Up Progress</span>
        <div class="text-2xl font-bold text-purple-900 mt-1">Day <%= warmUpDay %>/7</div>
      </div>
    </div>

    <!-- Statistics -->
    <div class="space-y-2">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider">Messaging Activity</h3>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="flex justify-between p-2.5 bg-gray-50 rounded border border-gray-200">
          <span class="text-gray-600">Messages Allowed:</span>
          <span class="font-bold text-green-600"><%= stats?.messagesAllowed || 0 %></span>
        </div>
        <div class="flex justify-between p-2.5 bg-gray-50 rounded border border-gray-200">
          <span class="text-gray-600">Messages Blocked:</span>
          <span class="font-bold text-red-600"><%= stats?.messagesBlocked || 0 %></span>
        </div>
      </div>
    </div>

    <!-- Protections Checklist -->
    <div class="space-y-2">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider">Active Protections</h3>
      <div class="space-y-1.5 text-xs text-gray-600 bg-gray-50 p-3 rounded-lg border border-gray-200">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Gaussian Jitter & Dynamic Delays</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Circadian Presence Choreography (Asia/Jakarta)</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Health Risk Auto-Pause (high risk)</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Legitimacy Signal & Group Operation Guard</span>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="p-4 bg-yellow-50 text-yellow-800 text-sm rounded-lg border border-yellow-200">
      Anti-Ban protection is disabled or socket is not currently connected.
    </div>
    <% } %>

    <div class="pt-2 text-right">
      <button onclick="document.getElementById('modal-container').innerHTML = ''" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium rounded-lg transition">
        Close
      </button>
    </div>
  </div>
</div>
